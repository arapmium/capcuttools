# ==============================================================================
# CANVA SIGNUP + RESET PASSWORD TOOL - .gitignore
# Melindungi data sensitif agar tidak masuk ke repo
# ==============================================================================

# ── DATA SENSITIF (JANGAN PERNAH COMMIT) ─────────────────────────────────────
.env
.env.*
*.env

# File email, akun & hasil
emails.txt
akun_canva.txt
sukses_reset.txt
result.txt
*.txt

# Pengecualian: file txt yang boleh di-commit
!requirements.txt
!PANDUAN.txt

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Chrome Profiles (besar, tidak perlu di-commit) ───────────────────────────
chrome_profiles/
.uc_launch.lock

# ── Python Artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── Arsip ─────────────────────────────────────────────────────────────────────
*.zip
*.rar
*.7z
*.tar.gz

# ── Temp & Lock ───────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.lock
~$*

# ── Screenshot / Media ────────────────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.webm
