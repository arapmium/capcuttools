# ====================================================
# BOT CAPCUT TEAM SEATS - Konfigurasi (.env)
# Salin file ini menjadi .env dan isi nilainya
# ====================================================

# Password akun GSuite yang akan digunakan login CapCut
password_google=masuk123

# Mode plan: 'teams' atau 'individual'
planmode=teams

# Jumlah kursi/seat yang ditarget
seats/kursi=5

# Browser: chrome, chromium, opera, brave, edge, firefox, auto
browser=chrome

# Path executable browser (kosongkan = deteksi otomatis)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux: /usr/bin/google-chrome
browser_path=

# Mode proxy: http atau socks5
proxy_mode=http

# Proxy: host:port:user:pass ATAU host:port (kosongkan = tidak pakai)
proxy=

# Telegram Bot Token (dari @BotFather)
TELEGRAM_TOKEN=

# Telegram Chat ID (user/group yang menerima notifikasi)
TELEGRAM_CHAT_ID=

# ==============================================================
# AUTO BIND EMAIL (ARAPMIUM / TMAIL API)
# ==============================================================
auto_bind_email=true
tmail_domain=arapmium.web.id
tmail_api_url=https://arapmium.web.id
tmail_api_key=

# ==============================================================
# RESET / FORGOT PASSWORD CAPCUT
# ==============================================================
new_password=masuk123

# ==============================================================
# DAFTAR AKUN CAPCUT (ARAPMIUM EMAIL)
# ==============================================================
daftar_password=masuk123

# ==============================================================
# OTOMATISASI CANVA
# ==============================================================
canva_password=masuk123

# ==============================================================
# ROTASI IP OTOMATIS (OPSIONAL)
# ==============================================================
rotate_ip_url=
rotate_ip_first=false

# ==============================================================
# MODE BROWSER
# ==============================================================
# incognito = sesi bersih (default) | biasa = profil persisten
browser_mode=incognito

# ==============================================================
# RESTART SERVER PTERODACTYL (OPSIONAL)
# ==============================================================
ptero_url=
ptero_server_id=
ptero_api_key=
